<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WhitelistMute</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio.Wasapi 封装 Windows WASAPI/Core Audio API（枚举设备、会话、音量/静音）。netstandard2.0，可被 net48 引用 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="ILRepack.FullAuto" Version="1.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- 编译 net48 所需的引用程序集 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 构建前清理 ILRepack 残留，避免把上次已合并的 exe/NAudio 依赖重复合并导致体积膨胀 -->
  <Target Name="CleanIlRepackStale" BeforeTargets="PrepareForBuild">
    <Exec Command="del /q &quot;$(IntermediateOutputPath)$(AssemblyName).exe&quot; &quot;$(IntermediateOutputPath)$(AssemblyName).pdb&quot; &quot;$(OutDir)$(AssemblyName).exe&quot; &quot;$(OutDir)$(AssemblyName).pdb&quot; &quot;$(OutDir)NAudio.Core.dll&quot; &quot;$(OutDir)NAudio.Wasapi.dll&quot; 2>nul" IgnoreExitCode="true" />
  </Target>

</Project>